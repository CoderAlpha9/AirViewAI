digraph AirView {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.42", ranksep="0.65", splines=ortho, fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.16,0.10", color="#24494a", fontcolor="#EAF6F2", fillcolor="#0D2627", penwidth=1.2];
  edge [color="#59D7B3", penwidth=1.3, arrowsize=0.7];

  stations [label="CPCB / OpenAQ\nstation observations"];
  cams [label="Open-Meteo CAMS\ncurrent + outlook"];
  context [label="Weather / FIRMS / OSM\noperational context"];
  snapshot [label="Canonical snapshot\ncity + pollutant + horizon + issue"];
  transfer [label="Persistence-residual transfer\n(no CAMS values in training)"];
  grid [label="Current-category grid\nseparate horizon forecast"];
  panels [label="Independent live panels\nstale-response rejection"];
  compare [label="Fixed next-24h PM2.5 comparison\none context per city"];

  stations -> snapshot; cams -> snapshot; context -> snapshot;
  snapshot -> transfer; transfer -> grid; snapshot -> panels; grid -> panels;
  transfer -> compare; snapshot -> compare;
}
