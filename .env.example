# Backend service
AIRVIEW_ENVIRONMENT=development
AIRVIEW_API_HOST=127.0.0.1
AIRVIEW_API_PORT=8000
AIRVIEW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIRVIEW_LOG_LEVEL=INFO
AIRVIEW_LIVE_PROVIDER_TIMEOUT_SECONDS=20
AIRVIEW_OPERATIONAL_CACHE_SECONDS=600

# Optional live-provider credentials. Leave blank for a graceful unavailable state.
DATA_GOV_IN_API_KEY=
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional Ask AirView copilot. The API key is read only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AIRVIEW_COPILOT_ENABLED=true
AIRVIEW_COPILOT_TIMEOUT_SECONDS=20
AIRVIEW_COPILOT_MAX_OUTPUT_TOKENS=700
AIRVIEW_COPILOT_MAX_INPUT_CHARS=14000
AIRVIEW_COPILOT_RATE_LIMIT_PER_MINUTE=12

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
